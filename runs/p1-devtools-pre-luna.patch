+// One candidate check shared by the search and the fallback: the hex must
+// have floor data (fid != 0 in its square), be free of blocking objects and
+// not be a scroll-blocked hex on the target elevation.
+bool elevationTileFree(int tile, int elevation)
+{
+    if (tile < 0) {
+        return false;
+    }
+
+    int hexCol = HEX_GRID_WIDTH - 1 - tile % HEX_GRID_WIDTH;
+    int hexRow = tile / HEX_GRID_WIDTH;
+    int squareIndex = (hexRow / 2) * SQUARE_GRID_WIDTH + (hexCol / 2);
+    if (_square[elevation]->tileFid[squareIndex] == 0) {
+        return false; // void: no floor tile drawn
+    }
+    if (_obj_blocking_at(nullptr, tile, static_cast<MapElevation>(elevation)) != nullptr) {
+        return false;
+    }
+    if (_obj_scroll_blocking_at(tile, static_cast<MapElevation>(elevation)) != 0) {
+        return false;
+    }
+    return true;
+}
+
+// Finds a free hex on `elevation`, walking full rings around `center` up to
+// `maxDistance` (bounded: at most 1 + sum(6*d) candidates). -1 when none.
+int findFreeTileOnElevation(int center, int elevation, int maxDistance)
+{
+    if (center < 0) {
+        return -1;
+    }
+    if (elevationTileFree(center, elevation)) {
+        return center;
+    }
+
+    for (int distance = 1; distance <= maxDistance; distance++) {
+        int cursor = tileGetTileInDirection(center, static_cast<Rotation>(4), distance);
+        if (cursor == -1) {
+            continue;
+        }
+        for (int side = 0; side < 6; side++) {
+            for (int step = 0; step < distance; step++) {
+                cursor = tileGetTileInDirection(cursor, static_cast<Rotation>(side), 1);
+                if (cursor == -1) {
+                    break;
+                }
+                if (elevationTileFree(cursor, elevation)) {
+                    return cursor;
+                }
+            }
+        }
+    }
+    return -1;
+}
